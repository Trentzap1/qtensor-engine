  <script is:inline>
    // Brief Modal logic
    const modal = document.getElementById('brief-modal');
    const openBtn = document.getElementById('btn-open-brief');
    const closeBtn = document.getElementById('btn-close-brief');
    const form = document.getElementById('brief-form');
    const conf = document.getElementById('brief-confirmation');

    if (openBtn) openBtn.onclick = () => modal.classList.remove('hidden');
    if (closeBtn) closeBtn.onclick = () => modal.classList.add('hidden');
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      };
    }
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('btn-submit-request') || form.querySelector('button[type="submit"]');
        const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Submitting...</span>';
        }

        const email = document.getElementById('brief-email')?.value || '';
        const org = document.getElementById('brief-org')?.value || '';
        const hw = document.getElementById('brief-hw')?.value || 'NVIDIA RTX 5080 (16GB)';

        const payload = {
          "Work Email": email,
          "Organisation": org,
          "Target Hardware": hw,
          email: email,
          organisation: org,
          targetHardware: hw,
          _replyto: email,
          _subject: `QTensor Evaluation License Request - ${org}`
        };

        try {
          const endpoint = form.getAttribute('action') || 'https://formsubmit.co/ajax/consult@qtensor.com.au';
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          // Toggle UI to Request Received success state ONLY upon receiving a 200 OK response
          if (response.status === 200) {
            form.classList.add('hidden');
            conf.classList.remove('hidden');
          } else {
            console.error('Submission failed with status:', response.status);
            alert('Submission failed with status ' + response.status + '. Please try again or email consult@qtensor.com.au directly.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalBtnHtml;
            }
          }
        } catch (err) {
          console.error('Submission error:', err);
          alert('Network error submitting request. Please try again or email consult@qtensor.com.au directly.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
          }
        }
      });
    }
  </script>
