  <!-- MINIMALIST MODAL: TECHNICAL BRIEF ACCESS -->
  <div id="brief-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-8 border border-[#0b0b0b]/15 shadow-2xl relative">
