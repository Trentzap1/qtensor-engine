        </div>
        <div>
          <label class="block text-xs font-mono uppercase tracking-wider text-[#5b5a55] mb-1.5">Organisation *</label>
          <input 
            id="brief-org"
            name="Organisation"
            type="text" 
            required 
            placeholder="Automotive / Robotics / Hardware Co." 
            class="w-full px-4 py-2.5 bg-[#faf8f2] border border-[#0b0b0b]/15 rounded-lg text-sm text-[#0b0b0b] focus:outline-none focus:ring-1 focus:ring-[#0b0b0b]"
          />
        </div>
        <div>
          <label class="block text-xs font-mono uppercase tracking-wider text-[#5b5a55] mb-1.5">Target Hardware</label>
          <input 
            id="brief-hw"
            name="Target Hardware"
            type="text" 
            placeholder="e.g. NVIDIA RTX 5080 (16GB), Jetson Orin Nano, Apple M-Series" 
            class="w-full px-4 py-2.5 bg-[#faf8f2] border border-[#0b0b0b]/15 rounded-lg text-sm text-[#0b0b0b] focus:outline-none focus:ring-1 focus:ring-[#0b0b0b]"
          />
        </div>

        <button 
          type="submit" 
          id="btn-submit-request"
          class="w-full mt-2 inline-flex items-center justify-center gap-2 bg-[#0b0b0b] text-[#f5f2ea] py-3 rounded-lg text-sm font-medium hover:bg-black/85 transition-all cursor-pointer shadow-sm active:scale-95"
        >
          <span>Submit Request</span>
          <span aria-hidden="true">↗</span>
        </button>

        <p class="mt-3 text-xs text-[#5b5a55] font-mono leading-relaxed">
          Your information is securely routed to <a href="mailto:consult@qtensor.com.au" class="underline text-[#0b0b0b] hover:opacity-80">consult@qtensor.com.au</a>. For direct founder inquiries, contact Trent Parsons on <a href="https://www.linkedin.com/in/trent-i-parsons/" target="_blank" rel="noopener noreferrer" class="underline text-[#0b0b0b] hover:opacity-80">LinkedIn ↗</a>.
        </p>
      </form>

      <div id="brief-confirmation" class="hidden text-center py-6">
        <div class="w-10 h-10 mx-auto mb-3 rounded-full bg-[#0b0b0b] text-[#f5f2ea] flex items-center justify-center font-mono">
          ✓
        </div>
        <h4 class="text-lg font-medium text-[#0b0b0b] mb-1">Request Received</h4>
        <p class="text-xs text-[#5b5a55] leading-relaxed mb-6">
          Your evaluation license request has been submitted to consult@qtensor.com.au. An engineering representative will contact you with documentation credentials.
        </p>
        <button 
          type="button" 
          onclick="document.getElementById('brief-modal').classList.add('hidden')"
          class="inline-flex items-center justify-center px-6 py-2 rounded-full bg-[#0b0b0b] text-[#f5f2ea] text-xs font-medium hover:bg-black/85 transition-all cursor-pointer"
        >
          Close Window
        </button>
      </div>
    </div>
