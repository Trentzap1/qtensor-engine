  <script>
    function copyInstall() {
      navigator.clipboard.writeText('pip install qtensor');
      const btn = document.getElementById('copy-install');
      btn.textContent = 'copied!';
      btn.style.color = '#34d399';
      setTimeout(() => { btn.textContent = 'copy'; btn.style.color = ''; }, 2000);
    }
    function copyCode() {
      const code = `import qtensor\nfrom transformers import AutoModelForCausalLM\n\n# Load and compress via Information-Theoretic rank allocation\nmodel = AutoModelForCausalLM.from_pretrained("NousResearch/Meta-Llama-3-8B")\nmodel = qtensor.compress(model, strategy="asymmetric_v2", use_triton=True)`;
      navigator.clipboard.writeText(code);
      const btns = document.querySelectorAll('.copy-btn');
      btns.forEach(b => { if (b !== document.getElementById('copy-install')) { b.textContent = 'copied!'; b.style.color = '#34d399'; setTimeout(() => { b.textContent = 'copy'; b.style.color = ''; }, 2000); }});
    }
    // Smooth scroll metric bar (CSS animation fallback)
