        tps: "14.2 TPS"
      }
    };

    // ----------------------------------------------------
    // 2. SIMULATOR CONTROLLER
    // ----------------------------------------------------
    const btnRun = document.getElementById('btn-run-compile');
    const statusText = document.getElementById('simulator-status');
    const pulse = document.getElementById('compiling-pulse');
    const codeOutput = document.getElementById('code-output');

    const targetSelect = document.getElementById('hardware-target');
    const targetSummary = document.getElementById('target-summary');
    const activeModelSummary = document.getElementById('active-model-summary');
    const telBadge = document.getElementById('telemetry-badge');
    const line1 = document.getElementById('telemetry-line-1');
    const line2 = document.getElementById('telemetry-line-2');
    const line3 = document.getElementById('telemetry-line-3');
    const streamCursor = document.getElementById('stream-cursor');

    // Model Tab switcher
    document.querySelectorAll('.model-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mKey = btn.getAttribute('data-model');
        if (!modelProfiles[mKey]) return;
        currentModelKey = mKey;

        document.querySelectorAll('.model-tab-btn').forEach(b => {
          b.classList.remove('bg-[#0b0b0b]', 'text-[#f5f2ea]', 'border-[#0b0b0b]/20');
          b.classList.add('bg-white', 'text-[#5b5a55]', 'border-[#0b0b0b]/15');
        });
        btn.classList.add('bg-[#0b0b0b]', 'text-[#f5f2ea]', 'border-[#0b0b0b]/20');
        btn.classList.remove('bg-white', 'text-[#5b5a55]', 'border-[#0b0b0b]/15');

        const prof = modelProfiles[mKey];
        activeModelSummary.textContent = `Model: ${prof.name} | ${prof.footprint}`;
        
        // Auto-adjust target hardware dropdown
        if (mKey === 'gemma4') {
          targetSelect.value = 'rtx5080';
        } else if (mKey === 'qwen7b') {
          targetSelect.value = 'node4gb';
        }

        updateSimulatorView();
      });
    });

    // Preset button switcher
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentTaskKey = btn.getAttribute('data-preset');
        document.querySelectorAll('.preset-btn').forEach(b => {
          b.classList.remove('bg-[#f5f2ea]', 'text-[#0b0b0b]', 'border-[#0b0b0b]/20');
          b.classList.add('bg-white', 'text-[#5b5a55]', 'border-[#0b0b0b]/15');
        });
        btn.classList.add('bg-[#f5f2ea]', 'text-[#0b0b0b]', 'border-[#0b0b0b]/20');
        btn.classList.remove('bg-white', 'text-[#5b5a55]', 'border-[#0b0b0b]/15');

        updateSimulatorView();
        triggerCompile();
      });
    });

    function updateSimulatorView() {
      const model = modelProfiles[currentModelKey];
      const snippet = model.snippets[currentTaskKey] || model.snippets.search;
      document.getElementById('prompt-input').value = snippet.prompt;
    }

    targetSelect.addEventListener('change', () => {
      const hw = hardwareProfiles[targetSelect.value] || hardwareProfiles.node4gb;
      const model = modelProfiles[currentModelKey];
      targetSummary.textContent = `Target: ${hw.label} · ${hw.tps} Verified`;
      line2.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#34d399]"></span> ${hw.vramText}`;
    });

    let streamInterval = null;

    function streamCodeOutput(fullText) {
      if (streamInterval) clearInterval(streamInterval);
      codeOutput.textContent = "";
      streamCursor.classList.remove('opacity-0');
      
      let index = 0;
      const chunkSize = 20;
      streamInterval = setInterval(() => {
        index += chunkSize;
        if (index >= fullText.length) {
          codeOutput.textContent = fullText;
          clearInterval(streamInterval);
          streamCursor.classList.add('opacity-0');
          btnRun.disabled = false;
          statusText.textContent = "Execution complete · Verified deterministic exit";
          pulse.classList.add('opacity-0');
        } else {
          codeOutput.textContent = fullText.slice(0, index);
        }
      }, 35);
    }

    function triggerCompile() {
      const model = modelProfiles[currentModelKey];
      const hw = hardwareProfiles[targetSelect.value] || hardwareProfiles.node4gb;
      const snippet = model.snippets[currentTaskKey] || model.snippets.search;

      targetSummary.textContent = `Target: ${hw.label} · ${hw.tps} Verified`;
      statusText.textContent = `Executing deterministic ${model.name} compilation...`;
      pulse.classList.remove('opacity-0');
      btnRun.disabled = true;

      // Telemetry sequence
      line1.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse"></span> Compiling ${model.name}...`;
      line2.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-neutral-600"></span> ${hw.vramText}`;
      line3.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-neutral-600"></span> Measuring Cosine Similarity (Layer 24)...`;

      setTimeout(() => {
        line1.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#34d399]"></span> ${model.name} Compiled in 11.4s`;
        line2.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#34d399]"></span> ${hw.vramText}`;
      }, 180);

      setTimeout(() => {
        line3.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#34d399]"></span> Exit Cosine Sim: ${model.cosineSim} · 0% Repetition Loops`;
        statusText.textContent = `Streaming tokens @ ${hw.tps}`;
        streamCodeOutput(snippet.code);
      }, 400);
    }

    btnRun.addEventListener('click', () => {
      triggerCompile();
    });

    // Copy code button
    document.getElementById('btn-copy-code').addEventListener('click', () => {
      const text = codeOutput.textContent;
      navigator.clipboard.writeText(text);
      const btn = document.getElementById('btn-copy-code');
      btn.textContent = "Copied!";
      setTimeout(() => {
        btn.textContent = "Copy Code";
      }, 1500);
    });

    // ----------------------------------------------------
    // 3. ROBUST CALL-TO-ACTION & MODAL CONTROLLER
    // ----------------------------------------------------
    const modal = document.getElementById('brief-modal');
    const briefForm = document.getElementById('brief-form');
    const briefConf = document.getElementById('brief-confirmation');
    const btnDirectMailto = document.getElementById('btn-direct-mailto');
    const btnCopyBriefInfo = document.getElementById('btn-copy-brief-info');

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      setTimeout(() => {
        briefForm.classList.remove('hidden');
        briefConf.classList.add('hidden');
      }, 300);
    }

    // Attach to all buttons with data-modal-open="brief"
    document.querySelectorAll('[data-modal-open="brief"]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Attach to all close buttons
    document.querySelectorAll('[data-modal-close="brief"]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        closeModal();
      });
    });

    // Click outside backdrop to close
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Escape key closes modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    let lastSubmissionSummary = "";

    // Form submission handler
    briefForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById('btn-submit-request') || briefForm.querySelector('button[type="submit"]');
      const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Submitting...</span>';
      }

      const email = document.getElementById('brief-email')?.value || '';
      const org = document.getElementById('brief-org')?.value || '';
      const hw = document.getElementById('brief-hw')?.value || 'NVIDIA RTX 5080 (16GB)';

      lastSubmissionSummary = `QTensor Evaluation License Request:
Email: ${email}
Organisation: ${org}
Target Hardware: ${hw}
Timestamp: ${new Date().toISOString()}`;

      const payload = {
        "Work Email": email,
        "Organisation": org,
        "Target Hardware": hw,
        email: email,
        organisation: org,
        targetHardware: hw,
        _replyto: email,
        _subject: `QTensor Evaluation License Request - ${org}`
      };

      try {
        const endpoint = briefForm.getAttribute('action') || 'https://formsubmit.co/ajax/consult@qtensor.com.au';
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        // Toggle UI to Request Received success state ONLY upon receiving a 200 OK response
        if (response.status === 200) {
          briefForm.classList.add('hidden');
          briefConf.classList.remove('hidden');
        } else {
          console.error('Submission failed with status:', response.status);
          alert('Submission failed with status ' + response.status + '. Please try again or email consult@qtensor.com.au directly.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
          }
        }
      } catch (err) {
        console.error('Submission error:', err);
        alert('Network error submitting request. Please try again or email consult@qtensor.com.au directly.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHtml;
        }
      }
    });

    // Copy brief summary button
    btnCopyBriefInfo.addEventListener('click', () => {
      navigator.clipboard.writeText(lastSubmissionSummary);
      btnCopyBriefInfo.innerHTML = "<span>Copied to Clipboard!</span>";
      setTimeout(() => {
        btnCopyBriefInfo.innerHTML = "<span>Copy Request Summary to Clipboard</span>";
      }, 2000);
    });
  </script>
</body>
</html>
