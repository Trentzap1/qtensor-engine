---
const title = "ZeroFold // QTensor — ASVD-Bridge & Sovereign LLM Inference";
const description = "Sub-1.1GB VRAM. 38+ TPS. Zero Residual Collapse. Information-theoretic ASVD-Bridge architecture for edge and air-gapped enterprise AI. AU Provisional Patent #2026907153.";
---
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://qtensor.com.au" />
  <meta property="og:type" content="website" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    html { font-family: 'Inter', system-ui, sans-serif; }
    code, pre, .font-mono { font-family: 'JetBrains Mono', 'Fira Code', monospace; }
    ::selection { background: rgba(6,182,212,0.3); color: #f0f9ff; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #09090b; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 3px; }
    .gradient-text {
      background: linear-gradient(135deg, #f0f0f0 0%, #94a3b8 40%, #22d3ee 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .gradient-text-cyan {
      background: linear-gradient(90deg, #22d3ee, #34d399);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .card-border {
      border: 1px solid rgba(255,255,255,0.06);
      background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
    }
    .card-border:hover {
      border-color: rgba(6,182,212,0.25);
    }
    .glow-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: #22d3ee;
      box-shadow: 0 0 8px #22d3ee, 0 0 20px rgba(34,211,238,0.4);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(0.85); }
    }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    .cursor::after {
      content: '▋';
      animation: blink 1s step-end infinite;
      color: #22d3ee;
    }
    .hero-grid {
      background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .arch-icon {
      width: 44px; height: 44px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 10px;
      font-size: 1.25rem;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 0.875rem;
      background: linear-gradient(135deg, #06b6d4, #0891b2);
      color: #fff; border: none; cursor: pointer; transition: all 0.2s;
      box-shadow: 0 0 20px rgba(6,182,212,0.3);
      text-decoration: none;
    }
    .btn-primary:hover {
      box-shadow: 0 0 32px rgba(6,182,212,0.5);
      transform: translateY(-1px);
    }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 0.875rem;
      background: rgba(255,255,255,0.05); color: #e4e4e7;
      border: 1px solid rgba(255,255,255,0.1); cursor: pointer; transition: all 0.2s;
      text-decoration: none;
    }
    .btn-secondary:hover {
      background: rgba(255,255,255,0.09);
      border-color: rgba(255,255,255,0.2);
      transform: translateY(-1px);
    }
    .copy-btn {
      position: absolute; top: 10px; right: 10px;
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1);
      color: #94a3b8; font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem; padding: 4px 10px; border-radius: 5px; cursor: pointer;
      transition: all 0.15s;
    }
    .copy-btn:hover { background: rgba(6,182,212,0.15); color: #22d3ee; border-color: rgba(6,182,212,0.3); }
    .token-kw    { color: #c084fc; }
    .token-str   { color: #34d399; }
    .token-fn    { color: #60a5fa; }
    .token-var   { color: #f0f0f0; }
    .token-cmt   { color: #525252; font-style: italic; }
    .token-param { color: #fb923c; }
    .enterprise-grid {
      background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
      background-size: 24px 24px;
    }
  </style>
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased overflow-x-hidden">

  <!-- ═══════════════════════════════════════════════════════ NAV ═══ -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/[0.06] bg-zinc-950/85 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="glow-dot"></div>
        <span class="font-mono font-semibold text-sm tracking-tight">
          <span class="text-cyan-400">Zero</span><span class="text-white">Fold</span>
          <span class="text-zinc-600 mx-1.5">//</span>
          <span class="text-emerald-400">Q</span><span class="text-white">Tensor</span>
        </span>
        <span class="border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 text-[10px] font-mono px-2 py-0.5 rounded-full hidden sm:inline-block">
          AU Patent #2026907153
        </span>
      </div>
      <div class="flex items-center gap-5">
        <a href="#about" class="text-zinc-400 hover:text-zinc-100 text-sm transition-colors hidden md:block">About</a>
        <a href="#products" class="text-zinc-400 hover:text-zinc-100 text-sm transition-colors hidden md:block">Products</a>
        <a href="#benchmarks" class="text-zinc-400 hover:text-zinc-100 text-sm transition-colors hidden md:block">Benchmarks</a>
        <a href="#architecture" class="text-zinc-400 hover:text-zinc-100 text-sm transition-colors hidden md:block">Architecture</a>
        <a href="#team" class="text-zinc-400 hover:text-zinc-100 text-sm transition-colors hidden md:block">Team</a>
        <a href="#enterprise" class="text-zinc-400 hover:text-zinc-100 text-sm transition-colors hidden md:block">Enterprise</a>
        <a href="https://github.com/Trentzap1/qtensor-engine" target="_blank"
           class="flex items-center gap-2 text-zinc-300 hover:text-white text-xs bg-white/[0.05] border border-white/[0.08] px-3 py-1.5 rounded-md transition-all hover:bg-white/[0.09]">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════════════ HERO ═══ -->
  <section class="relative min-h-[92vh] flex flex-col items-center justify-center pt-20 hero-grid overflow-hidden">
    <!-- Glow orbs -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[450px] rounded-full" style="background: radial-gradient(ellipse, rgba(6,182,212,0.10) 0%, transparent 70%); pointer-events:none;"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[350px] h-[350px] rounded-full" style="background: radial-gradient(ellipse, rgba(16,185,129,0.08) 0%, transparent 70%); pointer-events:none;"></div>

    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <!-- Priority Protection Pill -->
      <div class="inline-flex items-center gap-2 border border-cyan-500/30 bg-cyan-500/5 text-cyan-300 text-xs font-mono px-4 py-1.5 rounded-full mb-8 tracking-wide">
        <div class="glow-dot" style="width:6px;height:6px;"></div>
        AU Provisional Patent #2026907153 · Zero-Overhead Subspace Stabilization
      </div>

      <!-- Main Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.05] mb-6">
        <span class="gradient-text">ASVD-Bridge:</span><br/>
        <span class="text-zinc-100">Zero-Overhead Subspace Stabilization</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-zinc-400 text-lg sm:text-xl max-w-3xl mx-auto mb-10 leading-relaxed">
        Breaking the VRAM and Sovereign Compute Wall. Compressing frontier 8B parameter models into a <span class="text-zinc-200 font-semibold">4.67 GB VRAM footprint</span> and 1.5B models into <span class="text-zinc-200 font-semibold">1.03 GB</span> at full production speeds on consumer silicon.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-14">
        <a href="/ASVD_Bridge_Paper.pdf" target="_blank" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8" stroke="currentColor" fill="none" stroke-width="2"></polyline></svg>
          Read the Whitepaper (PDF)
        </a>
        <a href="#products" class="btn-secondary">
          Explore Product Suite →
        </a>
        <a href="https://huggingface.co/trentzap/ASVD-Bridge-Coder-1.5B" target="_blank" class="btn-secondary">
          🤗 Hugging Face Weights
        </a>
      </div>

      <!-- Quick Terminal Preview -->
      <div class="max-w-xl mx-auto">
        <div class="bg-zinc-900 border border-white/[0.08] rounded-xl overflow-hidden shadow-2xl text-left">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-white/[0.06] bg-zinc-900/80">
            <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
            <span class="ml-2 text-xs text-zinc-500 font-mono">air-gapped local api test</span>
            <button id="copy-install" class="copy-btn" onclick="copyInstall()">copy</button>
          </div>
          <div class="px-5 py-4 font-mono text-xs sm:text-sm text-zinc-300">
            <span class="text-emerald-400">$</span>
            <span class="text-cyan-300 ml-2">curl -X POST http://127.0.0.1:8000/v1/chat/completions \</span><br/>
            <span class="text-zinc-500 ml-6">-H "Content-Type: application/json" \</span><br/>
            <span class="text-zinc-500 ml-6">{`-d '{"model":"asvd-bridge-coder-1.5b","messages":[{"role":"user","content":"def quicksort(arr):"}]}'`}</span>
            <span class="cursor"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ METRICS TICKER ═══ -->
  <section class="py-0 border-y border-white/[0.06] bg-zinc-950 overflow-hidden">
    <div class="flex" style="animation: scrollX 24s linear infinite;">
      {[1,2].map(() => (
        <div class="flex shrink-0 items-stretch">
          {[
            { val: "1.03 GB", label: "Coder VRAM", sub: "ASVD-Bridge-Coder-1.5B", color: "cyan" },
            { val: "38.39 t/s", label: "Inference TPS", sub: "Zero-Overhead Folded", color: "emerald" },
            { val: "750 Steps", label: "Atomic Sprint", sub: "0 Bytes Disk Writes", color: "cyan" },
            { val: "1,498.4 t/s", label: "Distillation TPS", sub: "RTX 5080 Validated", color: "emerald" },
            { val: "H(S) = 2.48", label: "Shannon Entropy", sub: "State Preservation", color: "cyan" },
            { val: "AU Patent", label: "#2026907153", sub: "LegalVision Priority", color: "emerald" },
          ].map((m) => (
            <div class="flex items-center border-r border-white/[0.06] px-10 py-5 gap-4 shrink-0">
              <div class={`w-1.5 h-8 rounded-full ${m.color === 'cyan' ? 'bg-cyan-400' : 'bg-emerald-400'}`} style={`box-shadow: 0 0 12px ${m.color === 'cyan' ? '#22d3ee' : '#34d399'};`}></div>
              <div>
                <div class={`text-xl font-bold font-mono ${m.color === 'cyan' ? 'text-cyan-400' : 'text-emerald-400'}`}>{m.val}</div>
                <div class="text-zinc-100 text-sm font-semibold">{m.label}</div>
                <div class="text-zinc-500 text-xs font-mono">{m.sub}</div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ ABOUT SECTION ═══ -->
  <section id="about" class="py-28 border-b border-white/[0.05] bg-zinc-950/40 relative">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="text-xs font-mono text-cyan-400 tracking-widest uppercase mb-3">About ZeroFold & QTensor</div>
        <h2 class="text-4xl font-bold tracking-tight text-zinc-100 mb-6">
          Shattering the VRAM Wall with Mathematical Rigor
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed">
          ZeroFold was founded on a simple thesis: modern frontier intelligence is artificially constrained by memory bandwidth and cloud centralization. We engineer information-theoretic neural architectures that run natively on consumer hardware and sovereign on-premise infrastructure.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="card-border rounded-2xl p-8">
          <div class="text-cyan-400 font-mono text-2xl font-bold mb-4">01</div>
          <h3 class="text-zinc-100 font-semibold text-xl mb-3">The Mathematical Core</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Conventional low-rank matrix decomposition causes downstream activation variance to collapse. The ASVD-Bridge inserts a learnable Rank-1 Subspace Bridge (&gamma;) that dynamic-calibrates variance during distillation, then deterministically folds into the weights at export for zero runtime overhead.
          </p>
        </div>

        <div class="card-border rounded-2xl p-8">
          <div class="text-emerald-400 font-mono text-2xl font-bold mb-4">02</div>
          <h3 class="text-zinc-100 font-semibold text-xl mb-3">Sovereign & Air-Gapped</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Mission-critical industries—defense, M&A diligence, government, and robotics—cannot transmit classified tokens over public cloud APIs. Our models and serving shells operate in 100% air-gapped environments with verified zero network telemetry.
          </p>
        </div>

        <div class="card-border rounded-2xl p-8">
          <div class="text-cyan-400 font-mono text-2xl font-bold mb-4">03</div>
          <h3 class="text-zinc-100 font-semibold text-xl mb-3">Patent-Protected Moat</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Prosecuted in partnership with leading corporate IP firm LegalVision, Australian Provisional Patent #2026907153 secures our priority date over the Subspace Stabilization mechanics, dynamic SVD rank redistribution, and deterministic weight folding compilation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ PRODUCT SECTION ═══ -->
  <section id="products" class="py-28 border-b border-white/[0.05]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <div class="text-xs font-mono text-emerald-400 tracking-widest uppercase mb-3">Product Portfolio</div>
        <h2 class="text-4xl font-bold tracking-tight text-zinc-100 mb-6">
          Production-Grade Edge & Sovereign Infrastructure
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed">
          From compilation and training engines to air-gapped deployment servers and pre-compiled model artifacts, our product suite provides end-to-end edge AI execution.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-12">
        <!-- Product 1 -->
        <div class="card-border rounded-2xl p-8 relative group hover:border-cyan-500/30 transition-all">
          <div class="flex items-center justify-between mb-6">
            <div class="arch-icon bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono font-bold">
              01
            </div>
            <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-3 py-1 rounded-full">
              Compiler & Distillation Engine
            </span>
          </div>
          <h3 class="text-2xl font-bold text-zinc-100 mb-3">ASVD-Bridge Compression Engine</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6">
            An automated compilation pipeline that applies dynamic rank SVD across attention projections, INT4 physical packing across MLP blocks, and trains the Subspace Bridge scalar via Quantization-Aware Distillation (QAD). Folds permanently upon export with 0.00 ns runtime latency.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/[0.06] text-xs font-mono">
            <div>
              <span class="text-zinc-500 block">Attention Topology:</span>
              <span class="text-cyan-300 font-semibold">Dynamic SVD (r ∈ [12, 24])</span>
            </div>
            <div>
              <span class="text-zinc-500 block">MLP Topology:</span>
              <span class="text-emerald-300 font-semibold">AWQ INT4 (Group Size 128)</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Stabilization:</span>
              <span class="text-cyan-300 font-semibold">Rank-1 Folded Scalar (&gamma;)</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Runtime Overhead:</span>
              <span class="text-emerald-300 font-semibold">0.00 ns (GEMM Native)</span>
            </div>
          </div>
        </div>

        <!-- Product 2 -->
        <div class="card-border rounded-2xl p-8 relative group hover:border-emerald-500/30 transition-all">
          <div class="flex items-center justify-between mb-6">
            <div class="arch-icon bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono font-bold">
              02
            </div>
            <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">
              Enterprise Serving Shell
            </span>
          </div>
          <h3 class="text-2xl font-bold text-zinc-100 mb-3">Air-Gapped Zero-Telemetry API (FastAPI)</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6">
            A production-hardened local API wrapper engineered with socket-level egress blocking. Guaranteed zero outbound network traffic, offline OpenAPI schemas, and OpenAI-compatible drop-in endpoints (<code class="text-emerald-300 bg-zinc-900 px-1 py-0.5 rounded">/v1/chat/completions</code>) with server-sent events (SSE) streaming.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/[0.06] text-xs font-mono">
            <div>
              <span class="text-zinc-500 block">Egress Protection:</span>
              <span class="text-emerald-300 font-semibold">Socket Monkey-Patch Guard</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Protocol Compatibility:</span>
              <span class="text-cyan-300 font-semibold">OpenAI v1 Spec + SSE</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Telemetry Leakage:</span>
              <span class="text-emerald-300 font-semibold">Strictly 0 Bytes Outbound</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Deployment Target:</span>
              <span class="text-cyan-300 font-semibold">Localhost / Air-Gapped K8s</span>
            </div>
          </div>
        </div>

        <!-- Product 3 -->
        <div class="card-border rounded-2xl p-8 relative group hover:border-cyan-500/30 transition-all">
          <div class="flex items-center justify-between mb-6">
            <div class="arch-icon bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono font-bold">
              03
            </div>
            <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-3 py-1 rounded-full">
              Deployable Model Weights
            </span>
          </div>
          <h3 class="text-2xl font-bold text-zinc-100 mb-3">ASVD-Bridge Model Series</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6">
            Pre-compiled standalone weights formatted with custom factored topologies. Ready to execute on consumer hardware with zero runtime framework dependencies. Available in 1.5B and 8B parameter variants.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/[0.06] text-xs font-mono">
            <div>
              <span class="text-zinc-500 block">ASVD-Bridge-Coder-1.5B:</span>
              <span class="text-cyan-300 font-semibold">1.03 GB VRAM · 38.39 TPS</span>
            </div>
            <div>
              <span class="text-zinc-500 block">ASVD-Bridge-8B:</span>
              <span class="text-emerald-300 font-semibold">4.67 GB VRAM · 32.93 TPS</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Storage Distribution:</span>
              <span class="text-cyan-300 font-semibold">Single Safetensors Shard</span>
            </div>
            <div>
              <span class="text-zinc-500 block">Hardware Floor:</span>
              <span class="text-emerald-300 font-semibold">RTX 3060 / Apple M-Series</span>
            </div>
          </div>
        </div>

        <!-- Product 4 -->
        <div class="card-border rounded-2xl p-8 relative group hover:border-emerald-500/30 transition-all">
          <div class="flex items-center justify-between mb-6">
            <div class="arch-icon bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono font-bold">
              04
            </div>
