---
// QTensor - Edge AI Inference Engine
// ZeroFold Design System: Sophisticated, pragmatic, highly spaced, and outcome-focused.
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QTensor Edge | Deterministic AI Inference Engine</title>
  <meta name="description" content="QTensor Edge is a deterministic, training-free LLM compression engine. Compile AI models for sub-3GB edge silicon using proprietary fixed-point Triton kernels. Engineered by ZeroFold." />

  <!-- Open Graph / Twitter Meta Tags -->
  <meta property="og:title" content="QTensor Edge | Deterministic AI Inference Engine" />
  <meta property="og:description" content="QTensor Edge is a deterministic, training-free LLM compression engine. Compile AI models for sub-3GB edge silicon using proprietary fixed-point Triton kernels. Engineered by ZeroFold." />
  <meta property="og:url" content="https://qtensor.com.au/" />
  <meta property="og:site_name" content="QTensor Edge" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="QTensor Edge | Deterministic AI Inference Engine" />
  <meta name="twitter:description" content="QTensor Edge is a deterministic, training-free LLM compression engine. Compile AI models for sub-3GB edge silicon using proprietary fixed-point Triton kernels. Engineered by ZeroFold." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#f5f2ea" />
  <meta name="color-scheme" content="light" />

  <style>
    :root {
      --paper: #f5f2ea;
      --paper-soft: #faf8f2;
      --paper-card: #ffffff;
      --ink: #0b0b0b;
      --muted: #5b5a55;
      --muted-light: #8e8d88;
      --border: rgba(11, 11, 11, 0.12);
      --border-subtle: rgba(11, 11, 11, 0.06);
    }

    body {
      background-color: var(--paper);
      color: var(--ink);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    .font-mono {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    }

    ::selection {
      background-color: var(--ink);
      color: var(--paper);
    }

    /* Modal Animation */
    .modal-backdrop {
      transition: opacity 0.25s ease-out;
    }
    .modal-panel {
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-hidden {
      opacity: 0;
      pointer-events: none;
    }
    .modal-hidden .modal-panel {
      transform: scale(0.96) translateY(8px);
    }
  </style>
</head>

<body class="min-h-screen bg-[#f5f2ea] text-[#0b0b0b] antialiased selection:bg-[#0b0b0b] selection:text-[#f5f2ea]">

  <!-- SITE HEADER -->
  <header class="sticky top-0 z-40 w-full bg-[#f5f2ea]/90 backdrop-blur-md border-b border-[#0b0b0b]/10 transition-all">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
      <div class="flex items-center gap-4 sm:gap-6">
        <a href="/" class="text-2xl font-semibold tracking-tight text-[#0b0b0b] hover:opacity-80 transition-opacity">
          QTensor
        </a>
        <a 
          href="https://zerofold.com.au/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[#0b0b0b]/5 text-[#5b5a55] border border-[#0b0b0b]/10 hover:text-[#0b0b0b] hover:border-[#0b0b0b]/25 transition-all"
        >
          <span>A ZeroFold Technology</span>
          <span aria-hidden="true" class="text-[10px]">↗</span>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#5b5a55]">
        <a href="#baseline" class="hover:text-[#0b0b0b] transition-colors">Baseline</a>
        <a href="#benchmarks" class="hover:text-[#0b0b0b] transition-colors">Benchmarks</a>
        <a href="#engine" class="hover:text-[#0b0b0b] transition-colors">The Engine</a>
        <a href="#simulator" class="hover:text-[#0b0b0b] transition-colors">Simulator</a>
        <a href="#models" class="hover:text-[#0b0b0b] transition-colors">Models</a>
        <a href="/contact" class="hover:text-[#0b0b0b] transition-colors">Contact</a>
      </nav>

      <div class="flex items-center gap-3">
        <a 
          href="#simulator"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium border border-[#0b0b0b]/20 text-[#0b0b0b] hover:bg-[#0b0b0b]/5 transition-all"
        >
          <span>View Live Telemetry</span>
          <span aria-hidden="true" class="text-xs">↓</span>
        </a>
        <button 
          type="button"
          data-modal-open="brief"
          class="inline-flex items-center gap-2 bg-[#0b0b0b] text-[#f5f2ea] px-5 py-2.5 rounded-full text-sm font-medium hover:bg-black/85 transition-all cursor-pointer shadow-sm active:scale-95"
        >
          <span>Request Evaluation License</span>
          <span aria-hidden="true" class="text-xs">↗</span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- 1. HERO SECTION -->
    <section class="relative pt-20 pb-28 sm:pt-28 sm:pb-36 lg:pt-36 lg:pb-44 border-b border-[#0b0b0b]/10">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="max-w-4xl">
          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium uppercase tracking-wider bg-[#0b0b0b]/5 text-[#5b5a55] border border-[#0b0b0b]/10 mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>QTensor v2.0 · Subspace Residual Bridging Engine</span>
          </div>

          <!-- Massive Headline -->
          <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-tight text-[#0b0b0b] leading-[1.03]">
            Edge AI Inference.<br />
            Compiled analytically.
          </h1>

          <!-- Subtext -->
          <p class="mt-8 sm:mt-10 text-xl sm:text-2xl text-[#5b5a55] font-normal leading-relaxed max-w-2xl">
            Zero-byte disk writes. Zero gradient training epochs. QTensor compresses foundation-class LLMs to sub-3GB edge silicon and consumer GPUs using deterministic linear algebra and subspace residual bridges.
          </p>

          <!-- Action Buttons -->
          <div class="mt-10 sm:mt-12 flex flex-wrap items-center gap-4 sm:gap-5">
            <button 
              type="button"
              data-modal-open="brief"
              class="inline-flex items-center gap-2 bg-[#0b0b0b] text-[#f5f2ea] px-7 py-3.5 rounded-full text-base font-medium hover:bg-black/85 transition-all cursor-pointer shadow-sm active:scale-95"
            >
              <span>Request Evaluation License</span>
              <span aria-hidden="true">↗</span>
            </button>
            <a 
              href="#simulator"
              class="inline-flex items-center gap-2 border border-[#0b0b0b]/20 text-[#5b5a55] hover:text-[#0b0b0b] px-6 py-3.5 rounded-full text-base font-medium hover:bg-[#0b0b0b]/5 transition-all"
            >
              <span>View Live Telemetry ↓</span>
            </a>
          </div>

          <!-- Verification Badge -->
          <div class="mt-8 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs font-mono text-[#5b5a55]">
            <span class="flex items-center gap-1.5 text-[#0b0b0b]">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Verified on Silicon
            </span>
            <span>Llama 3.2 3B (2.98 GiB)</span>
            <span>Qwen 2.5 Coder 7B (3.02 GB)</span>
            <span>Gemma 4 E4B-IT (15.15 GB Peak)</span>
            <span>Gemma 2 9B (5.71 GB · 72.06% MMLU)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE BASELINE (The Verified Metrics) -->
    <section id="baseline" class="py-24 sm:py-32 border-b border-[#0b0b0b]/10 bg-[#faf8f2]">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="mb-14">
          <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-[#5b5a55] mb-3">
            The Baseline
          </p>
          <h2 class="text-3xl sm:text-4xl font-normal tracking-tight text-[#0b0b0b]">
            Deterministic performance verified on hardware silicon.
          </h2>
          <p class="mt-3 text-base text-[#5b5a55] max-w-2xl">
            Evaluated non-mocked with exact AST syntax validation, cosine similarity telemetry, and zero repetition loops.
          </p>
        </div>

        <!-- 3-Column Metric Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 border-y border-[#0b0b0b]/15 divide-y md:divide-y-0 md:divide-x divide-[#0b0b0b]/15">
          <!-- Metric 1 -->
          <div class="py-10 md:py-12 md:pr-10 lg:pr-12">
            <div class="text-5xl sm:text-6xl lg:text-7xl font-light tracking-tight text-[#0b0b0b] font-mono">
              15.15 GB
            </div>
            <div class="mt-4 text-base sm:text-lg text-[#0b0b0b] font-medium">
              Peak VRAM footprint on RTX 5080.
            </div>
            <p class="mt-2 text-sm text-[#5b5a55] leading-relaxed">
              Evaluates 4-billion parameter models entirely within consumer hardware limits without host swapping.
            </p>
          </div>

          <!-- Metric 2 -->
          <div class="py-10 md:py-12 md:px-10 lg:px-12">
            <div class="text-5xl sm:text-6xl lg:text-7xl font-light tracking-tight text-[#0b0b0b] font-mono">
              81.1%
            </div>
            <div class="mt-4 text-base sm:text-lg text-[#0b0b0b] font-medium">
              AST Syntactic Validity | 0.0% Degenerate Loop Collapse (LiveCodeBench v6).
            </div>
            <p class="mt-2 text-sm text-[#5b5a55] leading-relaxed">
              Retains 32.5% Pass@1 on AtCoder standard I/O.
            </p>
          </div>

          <!-- Metric 3 -->
          <div class="py-10 md:py-12 md:pl-10 lg:pl-12">
            <div class="text-5xl sm:text-6xl lg:text-7xl font-light tracking-tight text-[#0b0b0b] font-mono">
              14.2 TPS
            </div>
            <div class="mt-4 text-base sm:text-lg text-[#0b0b0b] font-medium">
              Sustained generation throughput.
            </div>
            <p class="mt-2 text-sm text-[#5b5a55] leading-relaxed">
              Instantaneous closed-form linear algebra compression executed with zero gradient training epochs.
            </p>
          </div>
        </div>

        <!-- Verification & Methodology Note -->
        <div class="mt-8 pt-6 border-t border-[#0b0b0b]/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <p class="text-xs sm:text-sm text-[#5b5a55] font-mono leading-relaxed max-w-4xl">
            Methodology: Evaluated live across official benchmark suites: HumanEval+ (54.88% Pass@1 on Qwen2.5-Coder-7B), LiveCodeBench v6 (175 problems, 81.1% AST, 58.1% Easy Pass@1 on Gemma 4 E4B-IT, 30.0% Pass@1 on Gemma 2 9B), MMLU 5-shot (72.06% Macro-Average / 95.82% retention on Gemma 2 9B QTensor), and Llama 3.2 3B (0.80 exit cosine similarity). Full audited telemetry maps and Triton kernel specifications are available in the Technical Brief.
          </p>
          <button 
            type="button"
            data-modal-open="brief"
            class="text-xs font-mono text-[#0b0b0b] hover:opacity-70 underline whitespace-nowrap cursor-pointer"
          >
            Request Evaluation License ↗
          </button>
        </div>
      </div>
    </section>

    <!-- 3. PRODUCTION MODEL MATRIX (New Data Showcase) -->
    <section id="benchmarks" class="py-24 sm:py-32 border-b border-[#0b0b0b]/10 bg-[#f5f2ea]">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-14">
          <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-[#5b5a55] mb-3">
            Hardware Verification
          </p>
          <h2 class="text-3xl sm:text-4xl font-normal tracking-tight text-[#0b0b0b]">
            Production Deployment Matrix
          </h2>
          <p class="mt-3 text-base text-[#5b5a55]">
            Real measured footprints, benchmark accuracy, and target silicon across verified QTensor compilations.
          </p>
        </div>

        <!-- Table Container -->
        <div class="bg-white border border-[#0b0b0b]/12 rounded-xl overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse font-mono text-xs sm:text-sm">
              <thead>
                <tr class="bg-[#faf8f2] border-b border-[#0b0b0b]/12 text-[#5b5a55] uppercase text-[11px] tracking-wider">
                  <th class="py-4 px-6 font-semibold">Model Architecture</th>
                  <th class="py-4 px-6 font-semibold">Base Footprint</th>
                  <th class="py-4 px-6 font-semibold">QTensor Footprint</th>
                  <th class="py-4 px-6 font-semibold">Reduction</th>
                  <th class="py-4 px-6 font-semibold">Verified Benchmark</th>
                  <th class="py-4 px-6 font-semibold">Target Hardware</th>
                  <th class="py-4 px-6 font-semibold text-right">Access</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#0b0b0b]/10 text-[#0b0b0b]">
                <!-- Row 1: Llama 3.2 3B v2 -->
                <tr class="hover:bg-[#f5f2ea]/50 transition-colors">
                  <td class="py-4 px-6 font-medium">
                    <div class="font-sans font-semibold text-[#0b0b0b]">Llama 3.2 3B QTensor v2</div>
                    <div class="text-[11px] text-[#5b5a55]">Protected Semantic Corridor Compilation</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">6.00 GiB (BF16)</td>
                  <td class="py-4 px-6 font-semibold text-emerald-700">2.98 GiB (v1) / 5.60 GiB (v2)</td>
                  <td class="py-4 px-6 font-medium text-emerald-600">-50.4% / -6.7%</td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center gap-1 text-[#0b0b0b]">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 0.8008 Cosine Sim
                    </span>
                    <div class="text-[11px] text-[#5b5a55]">Zero Repetition Loops</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">ARM Cortex / Apple Silicon / 4GB Edge</td>
                  <td class="py-4 px-6 text-right">
                    <button type="button" data-modal-open="brief" class="inline-flex items-center gap-1 text-xs font-mono font-medium text-[#0b0b0b] hover:opacity-70 underline cursor-pointer">
                      <span>Request Evaluation License</span> ↗
                    </button>
                  </td>
                </tr>

                <!-- Row 2: Qwen 2.5 Coder 7B -->
                <tr class="hover:bg-[#f5f2ea]/50 transition-colors">
                  <td class="py-4 px-6 font-medium">
                    <div class="font-sans font-semibold text-[#0b0b0b]">Qwen 2.5 Coder 7B QTensor</div>
                    <div class="text-[11px] text-[#5b5a55]">Tier 1 Analytical Corridor Compilation</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">14.2 GB (FP16)</td>
                  <td class="py-4 px-6 font-semibold text-emerald-700">3.02 GB</td>
                  <td class="py-4 px-6 font-medium text-emerald-600">-78.7%</td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center gap-1 text-[#0b0b0b]">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 54.88% Pass@1
                    </span>
                    <div class="text-[11px] text-[#5b5a55]">HumanEval+ Sandbox</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">4GB Industrial Edge / Jetson Orin</td>
                  <td class="py-4 px-6 text-right">
                    <button type="button" data-modal-open="brief" class="inline-flex items-center gap-1 text-xs font-mono font-medium text-[#0b0b0b] hover:opacity-70 underline cursor-pointer">
                      <span>Request Evaluation License</span> ↗
                    </button>
                  </td>
                </tr>

                <!-- Row 3: Gemma 4 E4B-IT -->
                <tr class="hover:bg-[#f5f2ea]/50 transition-colors">
                  <td class="py-4 px-6 font-medium">
                    <div class="font-sans font-semibold text-[#0b0b0b]">Gemma 4 E4B-IT QTensor</div>
                    <div class="text-[11px] text-[#5b5a55]">Analytical Subspace Bridge Compilation</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">16.0 GB (&gt;16GB OOM)</td>
                  <td class="py-4 px-6 font-semibold text-emerald-700">15.15 GB Peak VRAM</td>
                  <td class="py-4 px-6 font-medium text-emerald-600">Fits 16GB VRAM</td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center gap-1 text-[#0b0b0b]">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 81.1% AST Correct
                    </span>
                    <div class="text-[11px] text-[#5b5a55]">58.1% Pass@1 (LiveCodeBench v6)</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">RTX 5080 (16GB) / Consumer GPUs</td>
                  <td class="py-4 px-6 text-right">
                    <button type="button" data-modal-open="brief" class="inline-flex items-center gap-1 text-xs font-mono font-medium text-[#0b0b0b] hover:opacity-70 underline cursor-pointer">
                      <span>Request Evaluation License</span> ↗
                    </button>
                  </td>
                </tr>

                <!-- Row 4: Gemma 2 9B QTensor -->
                <tr class="hover:bg-[#f5f2ea]/50 transition-colors">
                  <td class="py-4 px-6 font-medium">
                    <div class="font-sans font-semibold text-[#0b0b0b]">Gemma 2 9B QTensor</div>
                    <div class="text-[11px] text-[#5b5a55]">Closed-Form Analytical Subspace Decomposition</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">18.5 GB (BF16)</td>
                  <td class="py-4 px-6 font-semibold text-emerald-700">
                    5.71 GB static
                    <div class="text-[11px] text-[#5b5a55] font-normal font-sans">11.10 GB peak VRAM</div>
                  </td>
                  <td class="py-4 px-6 font-medium text-emerald-600">-69.1% static</td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center gap-1 text-[#0b0b0b]">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 72.06% MMLU (95.82% ret.)
                    </span>
                    <div class="text-[11px] text-[#5b5a55]">30.0% Pass@1 (100% AST LiveCodeBench)</div>
                  </td>
                  <td class="py-4 px-6 text-[#5b5a55]">
                    <div>RTX 5080 (16GB) · 14.7 TPS</div>
                    <div class="text-[11px] text-emerald-700 font-medium">0.0% WDDM PCIe paging</div>
                  </td>
                  <td class="py-4 px-6 text-right">
                    <button type="button" data-modal-open="brief" class="inline-flex items-center gap-1 text-xs font-mono font-medium text-[#0b0b0b] hover:opacity-70 underline cursor-pointer">
                      <span>Request Evaluation License</span> ↗
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono text-[#5b5a55]">
          <span>* All models benchmarked zero-shot without fine-tuning or quantization calibration sets.</span>
          <a href="#simulator" class="text-[#0b0b0b] hover:opacity-70 underline">
            View Live Telemetry ↓
          </a>
        </div>

        <!-- ARCHITECTURE VALIDATION: GEMMA 2 9B QTENSOR (Enterprise Technical Specification) -->
        <div class="mt-14 bg-white border border-[#0b0b0b]/15 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-[#0b0b0b]/10 mb-8">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0b0b0b]/5 border border-[#0b0b0b]/10 text-xs font-mono uppercase tracking-wider text-[#5b5a55] mb-3">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Enterprise Technical Specification · Audited Telemetry</span>
              </div>
              <h3 class="text-2xl sm:text-3xl lg:text-4xl font-normal tracking-tight text-[#0b0b0b]">
                Architecture Validation: Gemma 2 9B QTensor
              </h3>
              <p class="mt-2 text-sm sm:text-base text-[#5b5a55] max-w-3xl">
                Non-mocked empirical audit on consumer silicon (NVIDIA RTX 5080 16GB) framing zero-paging tensor execution and preserved syntactic-semantic topology.
              </p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <button 
                type="button" 
                data-modal-open="brief" 
                class="inline-flex items-center gap-2 bg-[#0b0b0b] text-[#f5f2ea] px-6 py-3 rounded-full text-xs font-mono font-medium hover:bg-black/85 transition-all cursor-pointer shadow-sm active:scale-95 whitespace-nowrap"
              >
                <span>Request Benchmark Suite</span> ↗
              </button>
            </div>
          </div>

          <!-- 4 Pillars Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- 1. Semantic Fidelity -->
            <div class="bg-[#faf8f2] border border-[#0b0b0b]/10 rounded-xl p-5 sm:p-6 flex flex-col justify-between hover:border-[#0b0b0b]/25 transition-all">
              <div>
                <div class="text-[11px] font-mono uppercase tracking-wider text-[#5b5a55] flex items-center justify-between mb-2">
                  <span>Semantic Fidelity</span>
                  <span class="px-2 py-0.5 rounded text-[10px] bg-emerald-100 text-emerald-800 font-semibold font-mono">MMLU 5-Shot</span>
                </div>
                <div class="text-3xl sm:text-4xl font-light font-mono text-[#0b0b0b] tracking-tight">
                  72.06%
